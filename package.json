{
  "name": "retell-cli",
  "version": "2.0.0",
  "description": "Community CLI for Retell AI - efficient access to transcripts, agents, and prompts for AI assistants without MCP overhead",
  "main": "dist/index.js",
  "bin": {
    "retell": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --outfile=dist/index.js --banner:js=\"#!/usr/bin/env node\" --external:readline --packages=external",
    "dev": "npm run build -- --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "typecheck:tests": "tsc -p tests/tsconfig.json",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "retell",
    "retell-ai",
    "ai",
    "voice-ai",
    "cli",
    "transcript",
    "agent",
    "llm",
    "prompt-engineering",
    "conversation-flow",
    "voice-assistant",
    "call-analysis",
    "retell-sdk"
  ],
  "author": "awccom",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awccom/retell-cli.git"
  },
  "bugs": {
    "url": "https://github.com/awccom/retell-cli/issues"
  },
  "homepage": "https://github.com/awccom/retell-cli#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "retell-sdk": "6.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "whatwg-url": "^14.0.0",
    "tr46": "^5.0.0"
  }
}
